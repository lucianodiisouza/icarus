{
  "name": "@icarus/core",
  "version": "0.0.0",
  "private": true,
  "description": "Shell-agnostic core for Icarus: event bus, logger, config, and the environment doctor. No Electron (ADR-0002).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc"
  },
  "devDependencies": {
    "@icarus/config": "workspace:*",
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
